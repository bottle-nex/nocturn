
model AiQuizChatSession {
    id               String          @id @default(cuid())
    userId           String
    user             User            @relation(references: [id], fields: [userId], onDelete: Cascade)
    step             AgentStep
    instruction      String?
    difficulty       Int?
    quizId           String?         @unique
    quiz             Quiz?           @relation(references: [id], fields: [quizId], onDelete: Cascade)
    revisionFeedback String?
    messages         AiQuizMessage[]
    createdAt        DateTime        @default(now())
    updatedAt        DateTime        @updatedAt
}

model AiQuizMessage {
    id                  String            @id @default(cuid())
    aiQuizChatSessionId String
    aiQuizChatSession   AiQuizChatSession @relation(references: [id], fields: [aiQuizChatSessionId], onDelete: Cascade)
    role                AiQuizChatRole
    content             String
    element             AiMessageElement?
    createdAt           DateTime          @default(now())
    updatedAt           DateTime          @updatedAt
}