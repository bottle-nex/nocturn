model Template {
    id              String       @id @default(cuid())
    name            TemplateEnum @default(CLASSIC)
    backgroundColor String       @map("background_color")
    textColor       String       @map("text_color")
    borderColor     String       @map("border_color")
    accentType      String       @map("accent_type")
    accentColor     String       @map("accent_color")
    itemsColor      String       @map("items_color")
    itemsTextColor  String       @map("items_text_color")
    buttonColor     String       @map("button_color")      
    buttonTextColor String       @map("button_text_color")
    bars            String[]
    src             String

    userId          String?
    user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    quizzes   Quiz[]
}

/**
 * <---------- theme json data ---------->
 * background_color: string;
 * text_color: string;
 * border_color: string;
 * accent_type: string;
 * accent_color: string;
 * bars: string[];
 * src: string;
 */
