{
  "name": "server",
  "version": "1.0.0",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "build": "npx esbuild ./src/index.ts --bundle --platform=node --outdir=dist --format=cjs --loader:.ts=ts --sourcemap --minify --external:@aws-sdk/* --external:@langchain/* --external:@prisma/client --external:@prisma/instrumentation --external:bcryptjs --external:bull --external:chalk --external:cookie --external:cookie-parser --external:cors --external:dodopayments --external:dotenv --external:express --external:ioredis --external:jsonwebtoken --external:langchain --external:nanoid --external:node-cron --external:uuid --external:ws --external:zod",
    "start": "node dist/index.js",
    "dev": "pnpm build && pnpm start",
    "lint": "eslint './src/**/*.{ts,js}'",
    "remove-logs": "npx ts-node src/scripts/remove-logs",
    "format": "prettier --write './src/**/*.{ts,tsx,js,jsx,json,md}'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@langchain/core": "^1.1.15",
    "@langchain/google-genai": "^2.1.10",
    "@langchain/langgraph": "^1.1.2",
    "@langchain/openai": "^1.2.2",
    "@nocturn/database": "workspace:*",
    "@nocturn/typescript-config": "workspace:*",
    "@prisma/instrumentation": "^7.1.0",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "chalk": "^5.6.2",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dodopayments": "^2.19.0",
    "dotenv": "^17.2.0",
    "esbuild": "^0.25.6",
    "eslint": "^9.32.0",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.2.10",
    "nanoid": "^5.1.5",
    "node-cron": "^4.2.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@nocturn/types": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}