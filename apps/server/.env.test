# Test environment — accepted by env.ts Zod enum ['development', 'production', 'test']
SERVER_NODE_ENV=test

# Port — required by schema but never bound in mini-app tests
SERVER_PORT=0

# JWT secrets — must be >= 32 chars to pass Zod .min(32)
# These exact strings are mirrored in auth.helper.ts so real JWTs can be verified
SERVER_JWT_SECRET=test-jwt-secret-that-is-32-chars-long!
SERVER_JWT_REFRESH_SECRET=test-refresh-secret-that-is-32-chars!

# AWS — .min(1) validation only; never used at runtime (S3 client is mocked)
SERVER_AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
SERVER_AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
SERVER_AWS_REGION=eu-north-1
SERVER_AWS_BUCKET_NAME=test-bucket
SERVER_AWS_CLOUDFRONT_DOMAIN=test.cloudfront.net

# Redis — must pass z.url() (WHATWG URL validation); never connected (ioredis is mocked)
SERVER_REDIS_URL=redis://localhost:6379

# Web URL
SERVER_WEB_URL=http://localhost:3000

# Database — Prisma client is fully mocked; this string is never used at runtime
DATABASE_URL=postgresql://test:test@localhost:5432/test_db

# AI — never called at runtime (LangChain/model is mocked)
SERVER_GEMINI_API_KEY=test-gemini-api-key-placeholder

# Dodo payments — all .min(1); never called at runtime (payment service is mocked)
SERVER_DODO_API_KEY=test-dodo-api-key
SERVER_DODO_WEBHOOK_SECRET=test-dodo-webhook-secret-value
SERVER_DODO_ENVIRONMENT=test
SERVER_DODO_PRO_PRODUCT_ID=test-pro-product-id
SERVER_DODO_ENTERPRISE_PRODUCT_ID=test-enterprise-product-id
