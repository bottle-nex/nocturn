{
    "extends": "@nocturn/typescript-config/nextjs.json",
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "plugins": [
            {
                "name": "next"
            }
        ],
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "incremental": true,
        "resolveJsonModule": true
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "next-env.d.ts",
        "next.config.js",
        ".next/types/**/*.ts",
        "postcss.config.mjs",
        "eslint.config.ts"
    ],
    "exclude": ["node_modules", ".next"]
}
