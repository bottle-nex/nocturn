{
  "name": "orchestrator",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "npx esbuild ./src/index.ts --bundle --platform=node --outdir=dist --format=cjs --loader:.ts=ts --sourcemap --external:@prisma/client --external:express --external:jsonwebtoken --external:@aws-sdk/client-s3 --external:@aws-sdk/s3-request-presigner --external:bull --external:ioredis --external:ws ",
    "start": "node dist/index.js",
    "dev": "pnpm build && pnpm start",
    "remove-logs": "npx ts-node src/scripts/remove-logs.ts",
    "lint": "eslint './src/**/*.{ts,js}'",
    "format": "prettier --write './src/**/*.{ts,tsx,js,jsx,json,md}'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@nocturn/database": "workspace:*",
    "bull": "4.16.5",
    "dotenv": "^17.2.2",
    "esbuild": "^0.25.6",
    "ioredis": "^5.7.0",
    "resend": "^6.8.0",
    "ts-node": "^10.9.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@nocturn/types": "workspace:*",
    "@nocturn/typescript-config": "workspace:*",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.38.0"
  }
}