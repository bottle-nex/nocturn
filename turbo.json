{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "GOOGLE_CLIENT_ID",
    "SERVER_NODE_ENV",
    "GITHUB_TOKEN",
    "GOOGLE_CLIENT_SECRET",
    "NEXTAUTH_URL",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "FACEBOOK_CLIENT_ID",
    "FACEBOOK_CLIENT_SECRET"
  ],
  "tasks": {
    "generate": {
      "cache": false
    },
    "sync": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "remove-logs": {
      "cache": false,
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx}",
        "**/*.{ts,tsx,js,jsx}"
      ]
    },
    "test": {
      "dependsOn": ["^generate"],
      "inputs": [
        "src/**/*.ts",
        ".env.test",
        "vitest.config.ts"
      ],
      "outputs": ["coverage/**"],
      "cache": false
    }
  }
}